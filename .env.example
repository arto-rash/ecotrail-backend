APP_NAME=EcoTrail
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Comma-separated list of origins allowed to call the API (e.g. your Vercel domain)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Optional comma-separated regexes (with delimiters), e.g. Vercel previews: #^https://ecotrail-frontend(-[a-z0-9-]+)?\.vercel\.app$#
CORS_ALLOWED_ORIGIN_PATTERNS=

APP_LOCALE=az
APP_FALLBACK_LOCALE=az
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ecotrail
DB_USERNAME=ecotrail
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Shared-server deployment (deploy/deploy.sh + docker-compose.server.yml) ---
# LOG_CHANNEL=stderr
# API_HOST=api.example.com
# PROXY_NETWORK=portfelim_default
# PROXY_CONTAINER=portfelim-caddy-1
# PROXY_CADDYFILE=/opt/portfelim/deploy/Caddyfile
